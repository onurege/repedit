{
  "name": "@district/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "build": "tsc --noEmit",
    "migrate": "tsx src/migrate-cli.ts",
    "seed": "tsx src/seed.ts",
    "test": "vitest run --pool=forks --poolOptions.forks.singleFork=true",
    "report:overflow": "tsx src/report-overflow.ts"
  },
  "dependencies": {
    "@district/shared": "*",
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "pg": "^8.12.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.5.0",
    "@types/pg": "^8.11.6",
    "@types/ws": "^8.5.12",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4",
    "vitest": "^2.0.5"
  }
}
