# ============================================================
# Local development
# ============================================================
# Server
PORT=2567
DATABASE_URL=postgres://district:district@localhost:5432/business_district
# Enable in-game developer tools (add money, add milk, time warp, ...). Never enable in production.
DEV_TOOLS=1
NODE_ENV=development

# Client (Vite)
VITE_SERVER_URL=http://localhost:2567

# ============================================================
# Production (docker-compose.prod.yml) — see DEPLOYMENT.md
# ============================================================
# REQUIRED: set a strong database password. The prod stack builds the server's
# DATABASE_URL from these three values automatically.
POSTGRES_PASSWORD=change-me-to-a-strong-password
POSTGRES_USER=district
POSTGRES_DB=business_district
# Optional: restrict browser origins (comma-separated). Unset = allow all
# (fine behind the single-origin Caddy proxy).
# CORS_ORIGIN=https://play.example.com
