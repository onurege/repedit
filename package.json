{
  "name": "business-district",
  "private": true,
  "version": "0.1.0",
  "description": "BUSINESS DISTRICT — persistent multiplayer business simulation MVP",
  "workspaces": [
    "shared",
    "server",
    "client"
  ],
  "scripts": {
    "dev": "npm-run-all --parallel dev:server dev:client",
    "dev:server": "npm run dev -w server",
    "dev:client": "npm run dev -w client",
    "build": "npm run build -w shared && npm run build -w server && npm run build -w client",
    "start": "npm run start -w server",
    "migrate": "npm run migrate -w server",
    "seed": "npm run seed -w server",
    "test": "npm run test -w server",
    "e2e": "node e2e/golden-path.mjs",
    "e2e:chain": "node e2e/business-chain.mjs",
    "e2e:contract": "node e2e/contract.mjs",
    "e2e:company": "node e2e/company.mjs"
  },
  "devDependencies": {
    "npm-run-all": "^4.1.5",
    "playwright": "^1.46.0"
  }
}
